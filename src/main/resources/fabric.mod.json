{
	"schemaVersion": 1,
	"id": "blocky-outline",
	"version": "${version}",
	"name": "Blocky Outline",
	"description": "Customizable block selection outline and gradient fill with physics animation for Minecraft 26.1.x.",
	"authors": [
		"CharaZ"
	],
	"contact": {
		"sources": "https://github.com/EliteClockman-ctrl/blocky-outline",
		"issues": "https://github.com/EliteClockman-ctrl/blocky-outline/issues"
	},
	"license": "MIT",
	"icon": "assets/blocky-outline/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"charaz.blockoutline.BlockyOutlineMod"
		],
		"client": [
