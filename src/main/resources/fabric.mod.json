{
	"schemaVersion": 1,
	"id": "blocky-outline",
	"version": "${version}",
	"name": "Blocky Outline",
	"description": "Customizable block selection outline and gradient fill with physics animation for Minecraft 1.21.x.",
	"authors": [
		"CharaZ"
	],
	"contact": {
		"sources": "https://github.com/EliteClockman-ctrl/blocky-outline"
	},
	"license": "MIT",
	"icon": "assets/blocky-outline/icon.png",
